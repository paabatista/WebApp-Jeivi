rules_version = '2';

// Reglas de seguridad de Jeivi. Todo lo que no está permitido aquí queda DENEGADO.
// Usuarios (solo el equipo, por invitación): superadmin(100) > pastor(80) > diacono(50) > lider(30) > pendiente/sin acceso(10).
// Los líderes solo usan Lectura, Cumpleaños, Anuncios y Solicitudes: nada de Finanzas ni Eventos.
// Cada usuario solo ve los datos de SU iglesia (iglesiaId).
// La congregación NO tiene usuario: solo puede CREAR registros a través de un link activo
// (suscribirse, registrar cumpleaños, inscribirse a un evento, enviar una solicitud).
// Solo puede leer lo que es público a propósito: lectura del día, anuncios y eventos marcados como públicos.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function rutaYo() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function yo() { return get(rutaYo()).data; }
    function nivel(rol) {
      return rol == 'superadmin' ? 100 : rol == 'pastor' ? 80 : rol == 'diacono' ? 50 : rol == 'lider' ? 30 : 10;
    }
    function miNivel() { return autenticado() && exists(rutaYo()) ? nivel(yo().rol) : 0; }
    function deMiIglesia(ig) { return autenticado() && exists(rutaYo()) && yo().iglesiaId == ig; }
    function equipo(ig, minimo) { return deMiIglesia(ig) && miNivel() >= minimo; }

    // Un link público es válido si existe, está activo y es del módulo indicado.
    function enlaceValido(ig, token, modulo) {
      let ruta = /databases/$(database)/documents/iglesias/$(ig)/enlaces/$(token);
      return token is string && exists(ruta) && get(ruta).data.activo == true && get(ruta).data.modulo == modulo;
    }
    function texto(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function miCorreo() { return request.auth.token.email.lower(); }
    function rutaInvitacion(correo) { return /databases/$(database)/documents/invitaciones/$(correo); }

    // ---------- Usuarios ----------
    match /users/{uid} {
      allow read: if autenticado() && (
        request.auth.uid == uid ||
        (miNivel() >= 80 && resource.data.iglesiaId == yo().iglesiaId)
      );

      // Solo por invitación: el perfil se crea con el rol y la iglesia de la invitación,
      // y únicamente si el correo está verificado (Google lo verifica; con contraseña hay que confirmar el enlace).
      // El super admin NUNCA se puede crear desde la app: solo desde la consola de Firebase.
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.data.uid == uid
        && request.resource.data.email == miCorreo()
        && exists(rutaInvitacion(miCorreo()))
        && request.resource.data.rol == get(rutaInvitacion(miCorreo())).data.rol
        && request.resource.data.rol in ['pastor', 'diacono', 'lider']
        && request.resource.data.iglesiaId == get(rutaInvitacion(miCorreo())).data.iglesiaId;

      allow update: if autenticado() && (
        // El propio usuario: nombre, WhatsApp, suscripción… pero no su rol ni su iglesia.
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'iglesiaId', 'uid', 'email']))
        ||
        // Pastores y super admin: solo cambian el rol de alguien de nivel inferior, a un nivel inferior al suyo.
        (miNivel() >= 80
          && request.auth.uid != uid
          && resource.data.iglesiaId == yo().iglesiaId
          && nivel(resource.data.rol) < miNivel()
          && nivel(request.resource.data.rol) < miNivel()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rol']))
      );

      // Solo el super admin borra usuarios; nunca a sí mismo ni a otro super admin.
      allow delete: if miNivel() >= 100
        && request.auth.uid != uid
        && resource.data.rol != 'superadmin'
        && resource.data.iglesiaId == yo().iglesiaId;

      match /progresoLectura/{cicloId} {
        allow read, write: if autenticado() && request.auth.uid == uid;
      }
    }

    // ---------- Invitaciones (id = correo en minúsculas) ----------
    match /invitaciones/{correo} {
      // Cada quien puede consultar SU invitación; los pastores ven las de su iglesia.
      allow get: if autenticado() && (
        miCorreo() == correo ||
        (miNivel() >= 80 && resource.data.iglesiaId == yo().iglesiaId)
      );
      allow list: if miNivel() >= 80 && resource.data.iglesiaId == yo().iglesiaId;
      // Super admin invita pastores, diáconos y líderes; un pastor solo diáconos y líderes. Nadie invita super admins.
      allow create, update: if miNivel() >= 80
        && request.resource.data.iglesiaId == yo().iglesiaId
        && request.resource.data.email == correo
        && request.resource.data.rol in (miNivel() >= 100 ? ['pastor', 'diacono', 'lider'] : ['diacono', 'lider'])
        && texto(request.resource.data.nombre, 1, 80);
      allow delete: if miNivel() >= 80
        && resource.data.iglesiaId == yo().iglesiaId
        && (miNivel() >= 100 || resource.data.rol in ['diacono', 'lider']);
    }

    // ---------- Iglesia ----------
    match /iglesias/{ig} {
      // Público: nombre, colores y logo (login y páginas públicas).
      allow read: if true;
      allow write: if equipo(ig, 100);

      // Links públicos: se abren por su id (token), pero no se pueden listar sin ser del equipo.
      match /enlaces/{token} {
        allow get: if true;
        allow list: if equipo(ig, 30);
        allow create: if equipo(ig, 50) || (equipo(ig, 30) && request.resource.data.modulo in ['lectura', 'cumpleanos', 'anuncios', 'solicitudes']);
        allow update: if equipo(ig, 50) || (equipo(ig, 30) && resource.data.modulo in ['lectura', 'cumpleanos', 'anuncios', 'solicitudes']
                                             && request.resource.data.modulo == resource.data.modulo);
        allow delete: if equipo(ig, 80);
      }

      // ----- Lectura Bíblica -----
      match /lectura/config {
        allow read: if true;
        allow write: if equipo(ig, 80);
      }
      match /lecturaAjustes/{dia} {
        allow read: if true;
        allow write: if equipo(ig, 30);
      }
      match /suscriptores/{id} {
        allow read, update: if equipo(ig, 30);
        allow delete: if equipo(ig, 80);
        allow create: if equipo(ig, 30) || (
          request.resource.data.keys().hasOnly(['nombre', 'email', 'whatsapp', 'enlace', 'activo', 'creado', 'temas'])
          && (enlaceValido(ig, request.resource.data.enlace, 'lectura') || enlaceValido(ig, request.resource.data.enlace, 'anuncios'))
          && (!('temas' in request.resource.data) || (request.resource.data.temas is list && request.resource.data.temas.size() <= 2))
          && texto(request.resource.data.nombre, 1, 80)
          && texto(request.resource.data.email, 0, 120)
          && texto(request.resource.data.whatsapp, 0, 20)
          && (request.resource.data.email.size() > 0 || request.resource.data.whatsapp.size() > 0)
          && request.resource.data.activo == true
        );
      }

      // ----- Cumpleaños -----
      // Encargado del mes (tipo ticket): la pastora asigna; el encargado (diácono o líder) solo marca a quién felicitó.
      match /cumpleEncargos/{mes} {
        allow read: if equipo(ig, 30);
        allow create, delete: if equipo(ig, 80);
        allow update: if equipo(ig, 80) || (
          equipo(ig, 30)
          && resource.data.diaconoUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hechos', 'estado', 'actualizado'])
        );
      }
      match /cumpleanos/{id} {
        allow read, update: if equipo(ig, 30);
        allow delete: if equipo(ig, 80);
        allow create: if equipo(ig, 30) || (
          request.resource.data.keys().hasOnly(['nombre', 'dia', 'mes', 'anio', 'foto', 'telefono', 'familia', 'grupo',
                                                'parentesco', 'origen', 'enlace', 'autorizaFoto', 'creado'])
          && request.resource.data.origen == 'link'
          && enlaceValido(ig, request.resource.data.enlace, 'cumpleanos')
          && texto(request.resource.data.nombre, 1, 80)
          && request.resource.data.dia is int && request.resource.data.dia >= 1 && request.resource.data.dia <= 31
          && request.resource.data.mes is int && request.resource.data.mes >= 1 && request.resource.data.mes <= 12
          && texto(request.resource.data.foto, 0, 400000)
          && request.resource.data.parentesco in ['titular', 'hijo']
        );
      }

      // ----- Anuncios / tablero -----
      // Los marcados como públicos los ve cualquiera (tablero del link); el resto solo el equipo.
      match /anuncios/{id} {
        allow read: if resource.data.publico == true || equipo(ig, 30);
        allow create, update: if equipo(ig, 30);
        allow delete: if equipo(ig, 80);
      }

      // ----- Eventos -----
      match /eventos/{id} {
        allow read: if resource.data.publico == true || equipo(ig, 50);
        allow create, update: if equipo(ig, 50);
        allow delete: if equipo(ig, 80);
      }
      match /inscripciones/{id} {
        allow read, update: if equipo(ig, 50);
        allow delete: if equipo(ig, 80);
        allow create: if equipo(ig, 50) || (
          request.resource.data.keys().hasOnly(['eventoId', 'nombre', 'telefono', 'email', 'personas', 'nota', 'enlace', 'creado'])
          && enlaceValido(ig, request.resource.data.enlace, 'eventos')
          && get(/databases/$(database)/documents/iglesias/$(ig)/enlaces/$(request.resource.data.enlace)).data.eventoId == request.resource.data.eventoId
          && texto(request.resource.data.nombre, 1, 80)
          && texto(request.resource.data.telefono, 0, 20)
          && texto(request.resource.data.email, 0, 120)
          && texto(request.resource.data.nota, 0, 300)
          && request.resource.data.personas is int && request.resource.data.personas >= 1 && request.resource.data.personas <= 20
        );
      }

      // ----- Solicitudes -----
      // Las confidenciales solo las ven pastores y super admin.
      match /solicitudes/{id} {
        allow read, update: if equipo(ig, 80) || (equipo(ig, 30) && resource.data.confidencial == false);
        allow delete: if equipo(ig, 80);
        allow create: if equipo(ig, 30) || (
          request.resource.data.keys().hasOnly(['tipo', 'nombre', 'telefono', 'email', 'mensaje', 'confidencial', 'estado',
                                                'seguimiento', 'origen', 'enlace', 'creado'])
          && request.resource.data.origen == 'link'
          && request.resource.data.estado == 'nueva'
          && request.resource.data.seguimiento.size() == 0
          && request.resource.data.confidencial is bool
          && enlaceValido(ig, request.resource.data.enlace, 'solicitudes')
          && texto(request.resource.data.tipo, 1, 60)
          && texto(request.resource.data.nombre, 1, 80)
          && texto(request.resource.data.telefono, 0, 20)
          && texto(request.resource.data.email, 0, 120)
          && texto(request.resource.data.mensaje, 1, 2000)
        );
      }

      // ----- Historial (auditoría) -----
      // Solo se AGREGA: nadie (ni el super admin) puede editar ni borrar el historial desde la app.
      match /historial/{id} {
        allow read: if equipo(ig, 80);
        allow create: if equipo(ig, 30)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.accion in ['crear', 'editar', 'borrar', 'lote', 'banner', 'archivo']
          && request.resource.data.modulo is string
          && request.resource.data.fecha is string;
        allow update, delete: if false;
      }

      // Registro de archivos (banners, fotos, comprobantes): también permanente.
      match /archivos/{id} {
        allow read: if equipo(ig, 30);
        allow create: if equipo(ig, 30) && request.resource.data.subidoPor == request.auth.uid;
        allow update, delete: if false;
      }

      // ----- Finanzas -----
      match /finConceptos/{id} {
        allow read: if equipo(ig, 50);
        allow write: if equipo(ig, 80);
      }
      // Cada diácono solo ve SUS cargos y aportes; los pastores ven todo.
      match /finCargos/{id} {
        allow read: if deMiIglesia(ig) && (miNivel() >= 80 || resource.data.diaconoUid == request.auth.uid);
        allow write: if equipo(ig, 80);
      }
      match /finPagos/{id} {
        allow read: if deMiIglesia(ig) && (miNivel() >= 80 || resource.data.diaconoUid == request.auth.uid);
        allow write: if equipo(ig, 80);
      }
      // Pagos que reporta el propio diácono: siempre con comprobante, quedan "pendiente"
      // hasta que un pastor los confirma (ahí se crea el aporte en finPagos) o los rechaza.
      match /finReportes/{id} {
        allow read: if deMiIglesia(ig) && (miNivel() >= 80 || resource.data.diaconoUid == request.auth.uid);
        allow create: if equipo(ig, 50)
          && request.resource.data.diaconoUid == request.auth.uid
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.monto is number && request.resource.data.monto > 0 && request.resource.data.monto < 100000
          && request.resource.data.fecha is string && request.resource.data.fecha.size() == 10
          && request.resource.data.comprobante.url is string && request.resource.data.comprobante.url.size() > 10
          && !('pagoId' in request.resource.data) && !('revisadoPor' in request.resource.data);
        allow update: if equipo(ig, 80);
        allow delete: if equipo(ig, 80) || (deMiIglesia(ig) && resource.data.diaconoUid == request.auth.uid && resource.data.estado == 'pendiente');
      }
      match /finGastos/{id} {
        allow read, write: if equipo(ig, 80);
      }
      // Proyectos e inversiones (no son gastos corrientes) e inventario de bienes: pastores y super admin.
      match /finProyectos/{id} {
        allow read, write: if equipo(ig, 80);
      }
      match /finProyectoMovs/{id} {
        allow read, write: if equipo(ig, 80);
      }
      match /bienes/{id} {
        allow read, write: if equipo(ig, 80);
      }
    }
  }
}
