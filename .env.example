# ===== Frontend (Vite) — Firebase → Configuración del proyecto → Tus apps → App web =====
# Estos valores son públicos por diseño (van en el navegador); la seguridad está en firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_IGLESIA_ID=imperio-de-vida
# Opcional: App Check (reCAPTCHA v3). Ver SEGURIDAD.md
VITE_RECAPTCHA_SITE_KEY=
# Firebase Storage (requiere plan Blaze): 1 = activo. Ver PUBLICAR.md
VITE_STORAGE_ACTIVO=

# ===== Servidor (solo en Vercel → Settings → Environment Variables; NUNCA en GitHub) =====
# JSON de la cuenta de servicio de Firebase (completo, o en base64)
FIREBASE_SERVICE_ACCOUNT=
# Secreto largo y aleatorio: Vercel lo envía al ejecutar el cron
CRON_SECRET=
# URL pública de la app (para los enlaces del correo)
APP_URL=https://jeivi.vercel.app
IGLESIA_ID=imperio-de-vida
# Correo: resend o brevo
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=Jeivi <lectura@ministeriojesucristoimperiodevida.com>
